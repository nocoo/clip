{
  "name": "clip",
  "private": true,
  "version": "1.1.0",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "lint": "biome check . --error-on-warnings",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --coverage",
    "test:e2e": "bun run scripts/run-e2e.ts",
    "test:integration": "echo 'No integration tests yet'",
    "quality:full": "bun run lint && bun run typecheck && bun run test:unit && bun run test:e2e && bun run lint:secrets && bun run lint:deps",
    "lint:secrets": "gitleaks detect --source . --verbose",
    "lint:deps": "osv-scanner --lockfile bun.lock",
    "prepare": "git config core.hooksPath scripts/hooks"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@nocoo/base-cli": "^0.3.0",
    "@types/bun": "1.4.3",
    "@vitest/coverage-v8": "5.0.4",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  },
  "overrides": {
    "devalue": "5.9.3",
    "esbuild": ">=0.28.1",
    "http-cache-semantics": "^4.3.0",
    "js-yaml": "^4.3.2",
    "nanoid": "^3.3.17",
    "postcss": ">=8.5.18",
    "sharp": "^0.35.5",
    "source-map-js": "^1.2.2",
    "svgo": ">=4.1.0",
    "vite": "^8.0.13",
    "smol-toml": "^1.9.0"
  }
}
